{
  "name": "More Boosty",
  "version": "1.0.0",
  "description": "__MSG_description__",
  "homepage_url": "https://github.com/WeslyG/more-boosty",
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https://api.boosty.to; base-uri 'none'; frame-src 'none'"
  },
  "icons": {
    "24": "assets/icon24.png",
    "128": "assets/icon.png"
  },
  "host_permissions": [
    "https://api.boosty.to/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boosty.to/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}
